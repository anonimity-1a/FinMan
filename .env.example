# Copy to .env in the repo root before `docker compose up`.
# This file is for the Compose stack. Local `npm run dev` still uses backend/.env.

MONGODB_DB=finman

# Must start with hf_. SMS parsing falls back to regex if the model call fails.
HF_TOKEN=
HF_MODEL=
HF_VISION_MODEL=

# At least 32 random characters. Replace this before anyone else can reach the laptop.
JWT_SECRET=f2aaa3d6bc8067184d6490d9e4baca444c2d8bd11c9b847687bb27d09f6bd7c3

ADMIN_EMAIL=admin@finman.com
ADMIN_PASSWORD=admin123
# Optional. Blank uses the part of ADMIN_EMAIL before @.
ADMIN_USERNAME=

# Optional second login. Leave blank to skip it.
DEMO_EMAIL=
DEMO_PASSWORD=

# false so the session cookie works on http://localhost:8080.
# Set true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Browser origin of the web app when you call the API directly.
# The Docker site is same-origin through nginx, so other devices on the LAN use WEB_PORT as-is.
CORS_ORIGIN=http://localhost:8080

# Host port for the web app. Other devices open http://<laptop-ip>:<WEB_PORT>.
WEB_PORT=8080
